    "rive:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rive.ps1 -Mode preview"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "6.4.3"
  }
}
